# ============================================================
# Odoo 配置
# ============================================================
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=admin@your-company.com
ODOO_PASSWORD=your_odoo_password

# ============================================================
# Slack 配置
# 在 https://api.slack.com/apps 创建 App 后获取以下 Token
# ============================================================
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================================
# Slack 频道 (填频道名称，不带 #)
# ============================================================
SLACK_CHANNEL_SALES=sales
SLACK_CHANNEL_FINANCE=finance
SLACK_CHANNEL_WAREHOUSE=warehouse
SLACK_CHANNEL_MANAGEMENT=general

# ============================================================
# 业务规则
# ============================================================
# 超过多少天无采购视为沉睡客户
DORMANT_CUSTOMER_DAYS=90
# 发票逾期超过多少天开始提醒
OVERDUE_INVOICE_DAYS=1
# 报价单超过多少天未确认开始提醒
QUOTATION_FOLLOWUP_DAYS=7
# 库存低于多少数量触发预警
LOW_STOCK_THRESHOLD=10

# ============================================================
# 时区 (推荐 Asia/Shanghai)
# ============================================================
TIMEZONE=Asia/Shanghai

# ============================================================
# Odoo 销售员 → Slack 用户 ID 映射 (可选)
# 格式: Odoo用户名=Slack用户ID，用逗号分隔
# Slack用户ID 在用户资料页面 "复制成员ID" 获取
# ============================================================
# SALESPERSON_MAP=张三=U012AB3CD,李四=U056EF7GH
SALESPERSON_MAP=
