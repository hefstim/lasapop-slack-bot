# ============================================================
# Odoo 配置
# ============================================================
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=admin@your-company.com
ODOO_PASSWORD=your_odoo_password

# ============================================================
# Slack 配置
# 在 https://api.slack.com/apps 创建 App 后获取以下 Token
# ============================================================
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================================
# Slack 频道 (填频道名称，不带 #)
# ============================================================
SLACK_CHANNEL_SALES=sales
SLACK_CHANNEL_FINANCE=finance
SLACK_CHANNEL_WAREHOUSE=warehouse
SLACK_CHANNEL_MANAGEMENT=general
# 数据巡检/新客户缺联系方式提醒发到这里。这是私有频道，必须填频道 ID
# (不是名字) —— bot 的 token 没有 groups:read 权限，读不到私有频道列表，
# 频道 ID 在频道详情页底部或"复制链接"里能拿到 (形如 C0123456789)
SLACK_CHANNEL_ODOO_REPORT=C0BAQCGCY8L

# ============================================================
# 业务规则
# ============================================================
# 超过多少天无采购视为沉睡客户
DORMANT_CUSTOMER_DAYS=90
# 发票逾期超过多少天开始提醒
OVERDUE_INVOICE_DAYS=1
# 发票逾期超过多少天就归入"超期/需人工复核"而不再走每日提醒
OVERDUE_INVOICE_MAX_DAYS=30
# 报价单超过多少天未确认开始提醒
QUOTATION_FOLLOWUP_DAYS=7
# 库存低于多少数量触发预警
LOW_STOCK_THRESHOLD=10
# 月度销售目标，用于日报/月报的进度展示 (0 = 不设置)
MONTHLY_SALES_TARGET=0
# 客户被标记"已联系"后，多少天内不重复提醒
CONTACTED_COOLDOWN_DAYS=14

# ============================================================
# 时区 (推荐 Asia/Shanghai)
# ============================================================
TIMEZONE=Asia/Shanghai

# ============================================================
# Google Sheets 导出 (沉默客户/逾期发票/客户联系方式导出用)
# ============================================================
GOOGLE_CREDENTIALS_FILE=google_credentials.json
GOOGLE_SHEET_ID=your_google_sheet_id

# ============================================================
# 允许永久拉黑客户 (Won't Buy) 的 Slack 用户 ID，逗号分隔
# ============================================================
ADMIN_USER_IDS=

# ============================================================
# Odoo 销售员 → Slack 用户 ID 映射 (可选)
# 格式: Odoo用户名=Slack用户ID，用逗号分隔
# Slack用户ID 在用户资料页面 "复制成员ID" 获取
# ============================================================
# SALESPERSON_MAP=张三=U012AB3CD,李四=U056EF7GH
SALESPERSON_MAP=
